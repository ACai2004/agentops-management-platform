# PostgreSQL（本地 Docker 运行，与 docker-compose.yml 保持一致）
DATABASE_URL=postgresql+psycopg://agentops:agentops@localhost:5432/agentops

# LLM 网关（Layer 2 起使用；MVP 阶段可留空）
DEEPSEEK_API_KEY=
# 备用模型 Key（Layer 2 起使用）
BACKUP_MODEL_KEY=
# 视觉模型 Key（Layer 5 起使用，OpenRouter）
OPENROUTER_KEY=
# LLM 模型（LiteLLM 格式：provider/model）
LLM_MODEL=deepseek/deepseek-v4-flash
# 视觉模型（OpenRouter qwen-VL，Layer 5 起使用）
VISION_MODEL=openrouter/qwen/qwen2.5-vl-72b-instruct

# 前端地址（CORS，Layer 8 起使用）
FRONTEND_URL=http://localhost:5173
